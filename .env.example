# IssueTrack Lite — environment configuration
# Copy to .env (or export in your shell) before running the app.
# No real secrets should appear in this file.

# SQLite database file location (path relative to workspace root, or absolute).
# The schema is auto-created on first run; seed data is auto-applied on a clean DB.
IT_DB_PATH=data/issuetrack.db

# Bind host / port are fixed by the contract: 0.0.0.0:8000
